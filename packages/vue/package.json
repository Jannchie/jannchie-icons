{
  "name": "@jannchie/icons-vue",
  "version": "0.7.0",
  "description": "Vue 3 component for Jannchie Icons: one <JIcon> for every icon, with app-wide radius and weight defaults, pixel hinting and duo-tone colors",
  "license": "MIT",
  "author": "Jianqi Pan",
  "homepage": "https://icons.jannchie.com",
  "bugs": {
    "url": "https://github.com/Jannchie/jannchie-icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jannchie/jannchie-icons.git",
    "directory": "packages/vue"
  },
  "keywords": [
    "icons",
    "svg",
    "line-icons",
    "vue", "vue3", "component"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./static": {
      "import": {
        "types": "./dist/static.d.ts",
        "default": "./dist/static.js"
      },
      "require": {
        "types": "./dist/static.d.cts",
        "default": "./dist/static.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@jannchie/icons": "^0.7.0",
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@jannchie/icons": "workspace:^"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "NOTICE"
  ]
}
