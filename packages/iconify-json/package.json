{
  "name": "@jannchie/iconify-json",
  "version": "0.8.0",
  "description": "Jannchie Icons in Iconify JSON format: one collection per corner radius (sharp, 0–3) and stroke weight (light, regular, bold)",
  "license": "MIT",
  "author": "Jianqi Pan",
  "homepage": "https://icons.jannchie.com",
  "bugs": {
    "url": "https://github.com/Jannchie/jannchie-icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jannchie/jannchie-icons.git",
    "directory": "packages/iconify-json"
  },
  "keywords": [
    "iconify",
    "iconify-json",
    "icons"
  ],
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./*.json": "./*.json",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.20"
  },
  "files": [
    "*.json",
    "index.js",
    "index.cjs",
    "index.d.ts",
    "index.d.cts",
    "NOTICE"
  ]
}
