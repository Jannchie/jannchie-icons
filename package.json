{
  "name": "jannchie-icons",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "audit:grid": "node --import ./scripts/node-ext.mjs scripts/audit-grid.mjs",
    "audit:caps": "node --import ./scripts/node-ext.mjs scripts/audit-caps.mjs",
    "audit:crowd": "node --import ./scripts/node-ext.mjs scripts/audit-crowd.mjs",
    "audit:icons": "node scripts/audit-icons.mjs",
    "margins": "node --import ./scripts/node-ext.mjs scripts/margins.mjs",
    "brand": "node --import ./scripts/node-ext.mjs scripts/brand.mjs",
    "build:packages": "node --import ./scripts/node-ext.mjs scripts/build-packages.mjs && pnpm build:components",
    "build:components": "node scripts/build-components.mjs",
    "test": "vitest run",
    "release-notes": "node scripts/release-notes.mjs",
    "version:set": "node scripts/version.mjs"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@countertype/clipper2-ts": "1.5.4-3.9a869ba",
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
